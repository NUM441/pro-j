NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ใช้สำหรับส่งอีเมลแจ้งเตือนแอดมินตอนมีข้อความจากปุ่มแชท "ติดต่อแอดมิน"
# CONTACT_SMTP_USER/PASSWORD ใช้ Gmail App Password (myaccount.google.com/apppasswords)
CONTACT_SMTP_USER=your-gmail@gmail.com
CONTACT_SMTP_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=admin-inbox@example.com

# Service role key (Project Settings -> API ใน Supabase) — สิทธิ์เต็ม ห้ามใช้ฝั่ง browser เด็ดขาด
# ใช้ในหน้า /admin เพื่อดู/ตอบข้อความของทุกคน
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
